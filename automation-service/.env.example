# ─── Kindoo Worker Auth ───────────────────────────────────────────────────
# Queue worker token. Must match KINDOO_WORKER_TOKEN in the Next.js app env.
KINDOO_WORKER_TOKEN=""

# ─── Queue Worker Connectivity (worker mode) ──────────────────────────────
# Public URL of the Next.js app containing /api/license-jobs/* routes.
# Local worker: use http://localhost:3000
# Hosted worker: use your app domain (e.g. https://kindoo.snicol.com)
KINDOO_APP_URL="https://your-hosted-kindoo-app.example.com"

# Optional worker tuning.
KINDOO_WORKER_ID=""
KINDOO_WORKER_CLAIM_LIMIT="3"
KINDOO_WORKER_INTERVAL_MS="600000"

# Kindoo automation credentials.
KINDOO_URL="https://web.kindoo.tech/"
KINDOO_EMAIL=""
KINDOO_CHURCH_USERNAME=""
KINDOO_CHURCH_PASSWORD=""

# Playwright runtime.
PLAYWRIGHT_HEADLESS="true"
PLAYWRIGHT_TIMEOUT_MS="30000"
PLAYWRIGHT_RETRY_COUNT="3"
PLAYWRIGHT_RETRY_DELAY_MS="300"
