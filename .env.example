# Copy to .env.local for local dev, or use as a template for production envs.
# If using devbox, .env.local is auto-generated for local dev.

# ─── Local SQLite (devbox default) ─────────────────────────────────────────
TURSO_DATABASE_URL="file:./local.db"
TURSO_AUTH_TOKEN=""

# ─── Auth.js ───────────────────────────────────────────────────────────────
AUTH_SECRET="your-super-secret-key-min-32-chars"
AUTH_URL="http://localhost:3000"

# ─── Admin access ─────────────────────────────────────────────────────────
ADMIN_EMAILS="admin@example.com"
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="change-me-once"
BLOB_READ_WRITE_TOKEN=""

# ─── Kindoo Worker Auth ───────────────────────────────────────────────────
# Shared queue-worker auth token. Must match automation-service KINDOO_WORKER_TOKEN.
KINDOO_WORKER_TOKEN=""
KINDOO_WORKER_STALE_MINUTES="60"

# ─── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@example.com"

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM_NUMBER="+15551234567"

NEXT_PUBLIC_APP_URL="http://localhost:3000"