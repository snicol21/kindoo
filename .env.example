# Copy to .env.local for local dev, or use as a template for production envs.
# If using devbox, .env.local is auto-generated for local dev.

# ─── Local SQLite (devbox default) ─────────────────────────────────────────
TURSO_DATABASE_URL="file:./local.db"
TURSO_AUTH_TOKEN=""

# ─── Auth.js ───────────────────────────────────────────────────────────────
AUTH_SECRET="your-super-secret-key-min-32-chars"
AUTH_URL="http://localhost:3000"

# ─── Admin access ─────────────────────────────────────────────────────────
ADMIN_EMAILS="admin@example.com"
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="change-me-once"
BLOB_READ_WRITE_TOKEN=""

# ─── Kindoo Worker Auth ───────────────────────────────────────────────────
# Shared queue-worker auth token. Must match automation-service KINDOO_WORKER_TOKEN.
KINDOO_WORKER_TOKEN=""
KINDOO_WORKER_STALE_MINUTES="60"

# Quiet window for early-morning access jobs. If the normal due clock time is at or
# after NIGHT_CUTOFF, or before MORNING_END (exclusive), the job is due at
# PULL_FORWARD_AT on the previous civil day in America/Denver. The access rule
# start and end times are not changed. Set the NEXT_PUBLIC_ mirrors to the same
# values so the dashboard countdown matches (client bundles cannot read the
# non-public names).
KINDOO_SCHEDULE_NIGHT_CUTOFF="21:00"
KINDOO_SCHEDULE_MORNING_END="08:00"
KINDOO_SCHEDULE_PULL_FORWARD_AT="21:00"
NEXT_PUBLIC_KINDOO_SCHEDULE_NIGHT_CUTOFF="21:00"
NEXT_PUBLIC_KINDOO_SCHEDULE_MORNING_END="08:00"
NEXT_PUBLIC_KINDOO_SCHEDULE_PULL_FORWARD_AT="21:00"

# ─── Facilities Lead Bookings API ─────────────────────────────────────────
# Dedicated Bearer token for POST/GET/DELETE /api/bookings (NOT the worker token).
# Generate a long random secret, set in Vercel/env, never commit the real value.
# Header: Authorization: Bearer <KINDOO_API_TOKEN>
KINDOO_API_TOKEN=""

# ─── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@example.com"

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM_NUMBER="+15551234567"

NEXT_PUBLIC_APP_URL="http://localhost:3000"