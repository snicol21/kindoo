# Copy to .env.local for local dev, or use as a template for production envs.
# If using devbox, .env.local is auto-generated for local dev.

# ─── Local SQLite (devbox default) ─────────────────────────────────────────
TURSO_DATABASE_URL="file:./local.db"
TURSO_AUTH_TOKEN=""

# ─── Auth.js ───────────────────────────────────────────────────────────────
AUTH_SECRET="your-super-secret-key-min-32-chars"
AUTH_URL="http://localhost:3000"

# ─── Google OAuth ──────────────────────────────────────────────────────────
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ─── Demo credentials (local dev only) ─────────────────────────────────────
DEMO_EMAIL="dev@localhost"
DEMO_PASSWORD="devpassword123"