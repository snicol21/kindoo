# ─── Copy this to .env.local and fill in your values ─────────────────────────
# If using devbox, .env.local is auto-generated for local dev. Only change
# the Google OAuth values — everything else works out of the box.

# ─── LOCAL DEV (auto-set by devbox) ──────────────────────────────────────────
# TURSO_DATABASE_URL="file:./local.db"   ← devbox sets this automatically
# TURSO_AUTH_TOKEN=""                    ← not needed for local SQLite

# ─── PRODUCTION (Turso cloud) ────────────────────────────────────────────────
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
AUTH_SECRET="your-super-secret-key-min-32-chars"
AUTH_URL="http://localhost:3000"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ─── Demo credentials (local dev only, no Google needed) ─────────────────────
DEMO_EMAIL="dev@localhost"
DEMO_PASSWORD="devpassword123"